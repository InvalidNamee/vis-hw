---
import { localeFromUrl, localizedHref } from '../i18n';
const locale = localeFromUrl(Astro.url);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const page = Astro.url.pathname.slice(base.length).replace(/^\/(?:en(?:\/|$))?/, '');
---
<div class="language-switch" role="group" aria-label={locale === 'en' ? 'Language' : '语言'}>
  <a href={localizedHref(page, 'zh-CN')} lang="zh-CN" hreflang="zh-CN" aria-current={locale === 'zh-CN' ? 'true' : undefined}>中文</a>
  <a href={localizedHref(page, 'en')} lang="en" hreflang="en" aria-current={locale === 'en' ? 'true' : undefined}>EN</a>
</div>
<script>
  const syncLinks = () => document.querySelectorAll<HTMLAnchorElement>('.language-switch a').forEach(link => {
    const target = new URL(link.href);
    target.search = location.search;
    target.hash = location.hash;
    link.href = target.href;
  });
  syncLinks();
  window.addEventListener('hashchange', syncLinks);
</script>
<style>
  .language-switch { display: inline-flex; flex-shrink: 0; border: 1px solid var(--border-soft); border-radius: 6px; padding: 2px; gap: 2px; }
  a { padding: 4px 7px; border-radius: 4px; font-size: 12px; line-height: 1.5; }
  a[aria-current] { background: var(--accent-soft); color: var(--accent-strong); font-weight: 650; }
</style>
