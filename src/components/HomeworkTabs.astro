---
import { translator } from '../i18n';
const t = translator(Astro.url);
import { Tabs, TabsList, TabsTrigger } from './starwind/tabs';
---
<div class="homework-tabs">
  <Tabs defaultValue="explanation">
    <TabsList aria-label={t("作业内容")}>
      <TabsTrigger value="explanation">{t("讲解")}</TabsTrigger>
      <TabsTrigger value="code">{t("关键代码")}</TabsTrigger>
      <TabsTrigger value="demo">{t("展示")}</TabsTrigger>
    </TabsList>
    <slot />
  </Tabs>
</div>
<style is:global>
  .homework-tabs [role="tablist"] { display: flex; justify-content: flex-start; gap: 28px; width: 100%; height: auto; padding: 0; background: transparent; border: 0; border-bottom: 1px solid var(--border-soft); border-radius: 0; }
  .homework-tabs [role="tab"] { flex: none; position: relative; height: auto; min-height: 40px; padding: 8px 0; border: 0; border-bottom: 2px solid transparent; border-radius: 0; font-size: 15px; font-weight: 500; color: var(--text-secondary); background: transparent; box-shadow: none; }
  .homework-tabs [role="tab"][aria-selected="true"] { color: var(--accent); border-bottom-color: var(--accent); background: transparent; box-shadow: none; }
  .homework-tabs [role="tabpanel"] { margin-top: 0; }
</style>
