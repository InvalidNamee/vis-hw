<box-model-demo>
  <figure class="box-model-figure" aria-labelledby="box-model-caption">
    <div class="margin-layer">
      <span class="layer-label margin-label">margin · 外边距</span>
      <div class="border-layer">
        <span class="layer-label border-label">border · 边框</span>
        <div class="padding-layer">
          <span class="layer-label padding-label">padding · 内边距</span>
          <div class="content-layer">content<br /><small>内容区</small></div>
        </div>
      </div>
    </div>
    <figcaption id="box-model-caption">盒模型层级示意（非等比例）：margin → border → padding → content</figcaption>
  </figure>
  <div class="box-model-notes" aria-label="盒模型尺寸说明">
    <div><strong>可见盒子</strong><span>border-box = content + padding + border</span></div>
    <div><strong>盒外距离</strong><span>margin 位于边框外，不计入声明宽度</span></div>
  </div>
</box-model-demo>

<style>
  box-model-demo { display: block; margin: 12px 0 32px; padding: 24px; border: 1px solid #e2e8f0; border-radius: 8px; background: #f8fafc; }
  .box-model-figure { margin: 0; text-align: center; }
  .margin-layer { max-width: 560px; margin: 0 auto; padding: 24px; border: 1px dashed #94a3b8; background: #e2e8f0; }
  .border-layer { position: relative; padding: 18px; border: 2px solid #2563eb; background: #dbeafe; }
  .padding-layer { position: relative; padding: 20px; border: 1px dashed #0f766e; background: #ccfbf1; }
  .content-layer { display: grid; min-height: 96px; place-items: center; padding: 16px; background: #fff; color: #1e3a8a; border: 1px solid #bfdbfe; font-weight: 650; }
  .content-layer small { color: #475569; font-size: 12px; font-weight: 400; }
  .layer-label { display: block; color: #334155; font-size: 12px; line-height: 1.4; text-align: left; }
  .margin-label { margin: -18px 0 6px; }.border-label { margin: -14px 0 6px; color: #1d4ed8; }.padding-label { margin: -14px 0 6px; color: #0f766e; }
  figcaption { margin-top: 16px; color: #475569; font-size: 13px; }
  .box-model-notes { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; max-width: 560px; margin: 20px auto 0; }
  .box-model-notes div { padding: 12px 14px; background: #fff; border: 1px solid #e2e8f0; border-radius: 6px; text-align: left; }
  .box-model-notes strong, .box-model-notes span { display: block; }.box-model-notes strong { color: #0f172a; font-size: 13px; }.box-model-notes span { margin-top: 4px; color: #64748b; font-size: 12px; line-height: 1.5; }
  @media (max-width: 560px) { box-model-demo { padding: 14px; }.margin-layer { padding: 18px; }.border-layer { padding: 14px; }.padding-layer { padding: 14px; }.box-model-notes { grid-template-columns: 1fr; } }
</style>
