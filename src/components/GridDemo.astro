<grid-demo>
  <div class="grid-demo-frame" aria-label="Grid 页面骨架演示">
    <div class="grid-demo-header"><strong>HEADER</strong><span>跨越两列</span></div>
    <div class="grid-demo-sidebar"><strong>ASIDE</strong><span>固定轨道</span><span>筛选条件</span></div>
    <div class="grid-demo-main"><strong>MAIN</strong><span>剩余空间</span><div class="grid-demo-cards"><i>内容 A</i><i>内容 B</i><i>内容 C</i></div></div>
    <div class="grid-demo-footer"><strong>FOOTER</strong><span>跨越两列</span></div>
  </div>
  <p class="grid-demo-note"><code>grid-template-areas</code> 把视觉区域映射到页面结构，内层卡片 Grid 再独立管理三列。</p>
</grid-demo>

<style>
  grid-demo { display: block; margin: 12px 0 32px; padding: 24px; border: 1px solid #e2e8f0; border-radius: 8px; background: #f8fafc; }
  .grid-demo-frame { display: grid; grid-template-columns: 140px minmax(0, 1fr); grid-template-areas: "header header" "sidebar main" "footer footer"; gap: 12px; max-width: 720px; margin: 0 auto; }
  .grid-demo-frame > div { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 14px; min-height: 54px; padding: 14px; border: 1px solid #bfdbfe; border-radius: 6px; color: #1e40af; font-size: 13px; }
  .grid-demo-header { grid-area: header; background: #dbeafe; }.grid-demo-sidebar { grid-area: sidebar; align-content: start; background: #f1f5f9; }.grid-demo-main { display: block !important; grid-area: main; background: #eff6ff; }.grid-demo-main > span { display: block; margin-top: 3px; color: #475569; }.grid-demo-footer { grid-area: footer; background: #f1f5f9; }
  .grid-demo-cards { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; margin-top: 14px; }.grid-demo-cards i { display: grid; min-height: 64px; place-items: center; border: 1px solid #bfdbfe; border-radius: 4px; background: #fff; color: #2563eb; font-style: normal; font-size: 12px; }
  .grid-demo-note { max-width: 720px; margin: 14px auto 0; color: #64748b; font-size: 13px; line-height: 1.6; }.grid-demo-note code { padding: 2px 5px; border-radius: 4px; background: #e0e7ff; color: #3730a3; }
  @media (max-width: 560px) { grid-demo { padding: 14px; }.grid-demo-frame { grid-template-columns: 1fr; grid-template-areas: "header" "sidebar" "main" "footer"; }.grid-demo-cards { grid-template-columns: 1fr; } }
</style>
