<flex-demo>
  <div class="flex-demo-stage">
    <div class="flex-demo-viewport" id="flex-demo-viewport" data-size="wide">
      <div class="flex-demo-frame" aria-label="Flex 工具栏对齐演示">
        <div class="flex-demo-title"><strong>布局实验台</strong><span>标题占据剩余空间</span></div>
        <div class="flex-demo-actions" aria-label="预览宽度">
          <button type="button" data-size="wide" aria-controls="flex-demo-viewport" aria-pressed="true">自适应宽度</button>
          <button type="button" data-size="narrow" aria-controls="flex-demo-viewport" aria-pressed="false">窄容器</button>
        </div>
      </div>
    </div>
  </div>
  <p class="flex-demo-status" data-status aria-live="polite">自适应宽度：空间充足时标题与按钮同行，空间不足时自动换行。</p>
  <div class="flex-demo-axis"><span>主轴：justify-content</span><span>交叉轴：align-items</span></div>
</flex-demo>

<script>
  class FlexDemo extends HTMLElement {
    connectedCallback() {
      if (this.dataset.initialized) return;
      this.dataset.initialized = 'true';
      const viewport = this.querySelector<HTMLElement>('[data-size].flex-demo-viewport')!;
      const buttons = [...this.querySelectorAll<HTMLButtonElement>('button[data-size]')];
      const status = this.querySelector<HTMLElement>('[data-status]')!;

      const setSize = (size: string) => {
        const narrow = size === 'narrow';
        viewport.dataset.size = size;
        buttons.forEach(button => button.setAttribute('aria-pressed', String(button.dataset.size === size)));
        status.textContent = narrow
          ? '窄容器：预览宽度限制为最大 320px，标题与按钮根据可用空间换行。'
          : '自适应宽度：空间充足时标题与按钮同行，空间不足时自动换行。';
      };

      buttons.forEach(button => button.addEventListener('click', () => setSize(button.dataset.size ?? 'wide')));
    }
  }

  if (!customElements.get('flex-demo')) customElements.define('flex-demo', FlexDemo);
</script>

<style>
  flex-demo { display: block; margin: 12px 0 32px; padding: 24px; border: 1px solid var(--border-soft); border-radius: 8px; background: var(--surface-muted); }
  .flex-demo-stage { min-height: 118px; padding: 12px; border-radius: 6px; background: var(--border-soft); }
  .flex-demo-viewport { width: 100%; max-width: 720px; margin: 0 auto; transition: max-width 180ms ease; }
  .flex-demo-viewport[data-size="narrow"] { max-width: 320px; }
  .flex-demo-frame { display: flex; align-items: center; flex-wrap: wrap; gap: 12px 20px; padding: 18px; border: 1px solid var(--diagram-border); border-radius: 6px; background: var(--accent-soft); }
  .flex-demo-title { display: flex; align-items: baseline; flex: 1 1 220px; min-width: 0; gap: 12px; color: var(--diagram-text); }.flex-demo-title strong { flex: 0 0 auto; }.flex-demo-title span { min-width: 0; overflow: hidden; color: var(--text-secondary); font-size: 13px; text-overflow: ellipsis; white-space: nowrap; }
  .flex-demo-actions { display: flex; flex: 0 0 auto; gap: 8px; }.flex-demo-actions button { padding: 6px 12px; border: 1px solid var(--diagram-border-strong); border-radius: 5px; background: var(--surface); color: var(--accent-strong); font-size: 13px; }.flex-demo-actions button[aria-pressed="true"] { border-color: var(--accent); background: var(--action); color: var(--on-action); }
  .flex-demo-status { max-width: 720px; margin: 12px auto 0; color: var(--text-secondary); font-size: 13px; line-height: 1.6; }
  .flex-demo-axis { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px 20px; max-width: 720px; margin: 8px auto 0; color: var(--text-subtle); font-size: 12px; }
  @media (max-width: 480px) { flex-demo { padding: 14px; }.flex-demo-stage { padding: 8px; }.flex-demo-title { flex-basis: 160px; } }
  @media (prefers-reduced-motion: reduce) { .flex-demo-viewport { transition: none; } }
</style>
