---
import { translator } from '../../../i18n';
const t = translator(Astro.url);
---
<layout-demo>
  <section class="layout-lab" aria-label={t("课程作品浏览页布局实验")}>
    <div class="lab-toolbar">
      <div><h2>{t("作品浏览页布局实验")}</h2><p>{t("调整筛选侧栏、区域间距和内边距，完成案例的响应式布局。")}</p></div>
      <button type="button" data-reset>{t("恢复默认")}</button>
    </div>
    <div class="lab-controls">
      <label>{t("预览宽度")}<select data-width><option value="wide">{t("自适应宽度")}</option><option value="narrow">{t("窄容器")}</option></select></label>
      <label>{t("侧栏宽度")} <output data-sidebar-output>160px</output><input data-sidebar type="range" min="100" max="220" step="10" value="160" /></label>
      <label>{t("区域间距")} <output data-gap-output>16px</output><input data-gap type="range" min="0" max="32" step="4" value="16" /></label>
      <label>{t("区域内边距")} <output data-padding-output>16px</output><input data-padding type="range" min="8" max="32" step="4" value="16" /></label>
    </div>
    <div class="preview-stage">
      <div class="preview-viewport" data-viewport>
        <div class="example-page" data-example>
          <div class="example-header"><strong>HEADER</strong><span>{t("可视化课程作品库 · 课程导航")}</span></div>
          <div class="example-body">
            <div class="example-sidebar"><strong>ASIDE</strong><span>{t("筛选作品")}</span><span>{t("主题 · 年份")}</span></div>
            <div class="example-main"><strong>MAIN</strong><p>{t("课程作品")}</p><div class="example-cards"><div>{t("城市热岛")}</div><div>{t("通勤流向")}</div><div>{t("空气质量")}</div></div></div>
          </div>
          <div class="example-footer">FOOTER <span>{t("课程说明与数据来源")}</span></div>
        </div>
      </div>
    </div>
    <p class="lab-status" data-status aria-live="polite">{t("作品页两列布局：筛选侧栏固定宽度，作品区占据剩余空间。")}</p>
    <div class="lab-note"><strong>{t("信息设计目标")}</strong><p>{t("调整间距时，检查筛选区与作品区是否分组清楚、三张卡片是否便于比较；再选择“窄容器”，确认布局转为顺序阅读，同时保留“筛选 → 浏览作品”的任务路径。")}</p></div>
  </section>
</layout-demo>

<script>
  import { translate } from '../../../i18n';
  const t = (text: string) => translate(document.documentElement.lang === 'en' ? 'en' : 'zh-CN', text);
  class LayoutDemo extends HTMLElement {
    connectedCallback() {
      if (this.dataset.initialized) return;
      this.dataset.initialized = 'true';
      const width = this.querySelector<HTMLSelectElement>('[data-width]')!;
      const sidebar = this.querySelector<HTMLInputElement>('[data-sidebar]')!;
      const gap = this.querySelector<HTMLInputElement>('[data-gap]')!;
      const padding = this.querySelector<HTMLInputElement>('[data-padding]')!;
      const viewport = this.querySelector<HTMLElement>('[data-viewport]')!;
      const example = this.querySelector<HTMLElement>('[data-example]')!;
      const update = () => {
        viewport.style.maxWidth = width.value === 'narrow' ? '360px' : '100%';
        example.style.setProperty('--sidebar-width', `${sidebar.value}px`);
        example.style.setProperty('--gap', `${gap.value}px`);
        example.style.setProperty('--padding', `${padding.value}px`);
        this.querySelector('output[data-sidebar-output]')!.textContent = `${sidebar.value}px`;
        this.querySelector('output[data-gap-output]')!.textContent = `${gap.value}px`;
        this.querySelector('output[data-padding-output]')!.textContent = `${padding.value}px`;
      };
      width.addEventListener('change', update);
      sidebar.addEventListener('input', update);
      gap.addEventListener('input', update);
      padding.addEventListener('input', update);
      this.querySelector('[data-reset]')!.addEventListener('click', () => {
        width.value = 'wide'; sidebar.value = '160'; gap.value = '16'; padding.value = '16'; update();
      });
      const observer = new ResizeObserver(([entry]) => {
        if (!entry.contentRect.width) return;
        const narrow = entry.contentRect.width <= 560;
        this.querySelector('[data-status]')!.textContent = narrow
          ? t("作品页单列布局：筛选项位于作品列表上方，作品卡片逐张排列；侧栏宽度设置暂不生效。")
          : t("作品页两列布局：筛选侧栏固定宽度，作品区占据剩余空间。");
      });
      observer.observe(viewport);
      this.observer = observer;
      update();
    }
    observer?: ResizeObserver;
    disconnectedCallback() { this.observer?.disconnect(); }
  }
  if (!customElements.get('layout-demo')) customElements.define('layout-demo', LayoutDemo);
</script>

<style>
  layout-demo { display: block; margin: 12px 0 32px; }
  .layout-lab { border: 1px solid var(--border-soft); background: var(--surface); border-radius: 8px; overflow: hidden; }
  .lab-toolbar { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 24px; }
  .lab-toolbar h2 { margin: 0; font-size: 20px; font-weight: 650; }.lab-toolbar p { margin: 4px 0 0; font-size: 14px; color: var(--text-secondary); }
  button { white-space: nowrap; border: 1px solid var(--border-strong); padding: 7px 12px; border-radius: 6px; font-size: 14px; background: var(--surface); }button:hover { background: var(--surface-raised); }
  .lab-controls { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 24px; padding: 20px 24px; border-block: 1px solid var(--border-soft); background: var(--surface-muted); }
  label { display: block; font-size: 14px; font-weight: 500; }output { float: right; color: var(--accent); font-variant-numeric: tabular-nums; }
  input { display: block; width: 100%; margin-top: 16px; accent-color: var(--accent); }select { display: block; width: 100%; margin-top: 8px; padding: 6px 10px; border: 1px solid var(--border-strong); border-radius: 5px; background: var(--surface); }
  .preview-stage { padding: 28px; background: var(--demo-stage); }.preview-viewport { margin: auto; width: 100%; container-type: inline-size; }
  .example-page { --sidebar-width: 160px; --gap: 16px; --padding: 16px; display: grid; gap: var(--gap); background: var(--surface); padding: var(--padding); border: 1px solid var(--border-strong); border-radius: 6px; }
  .example-header { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 8px; padding: var(--padding); background: var(--diagram-fill); color: var(--diagram-text); border: 1px solid var(--diagram-border); border-radius: 4px; }
  .example-header span, .example-footer span { font-size: 13px; }.example-header strong, .example-main strong, .example-sidebar strong { font-size: 13px; letter-spacing: .06em; }
  .example-body { display: grid; grid-template-columns: var(--sidebar-width) minmax(0, 1fr); gap: var(--gap); }
  .example-sidebar { display: flex; flex-direction: column; gap: 14px; padding: var(--padding); background: var(--surface-raised); border: 1px solid var(--border-strong); border-radius: 4px; }.example-sidebar span { font-size: 14px; color: var(--text-secondary); }
  .example-main { min-width: 0; padding: var(--padding); border: 1px solid var(--diagram-border-strong); background: var(--accent-soft); border-radius: 4px; color: var(--diagram-text); }.example-main p { font-size: 16px; margin: 10px 0 20px; }
  .example-cards { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--gap); }.example-cards div { display: grid; place-items: center; min-height: 90px; border: 1px solid var(--diagram-border); background: var(--surface); border-radius: 4px; font-size: 14px; }
  .example-footer { display: flex; flex-wrap: wrap; gap: 16px; padding: calc(var(--padding) * .75) var(--padding); font-size: 13px; color: var(--text-secondary); background: var(--surface-raised); border-radius: 4px; }
  .lab-status { margin: 0; padding: 15px 24px; font-size: 14px; color: var(--text-secondary); border-bottom: 1px solid var(--border-soft); }.lab-note { padding: 20px 24px; font-size: 14px; }.lab-note p { margin: 5px 0 0; color: var(--text-secondary); }
  @container (max-width: 560px) { .example-body, .example-cards { grid-template-columns: 1fr; }.example-sidebar { flex-direction: row; flex-wrap: wrap; }.example-cards div { min-height: 56px; } }
  @media (max-width: 800px) { .lab-controls { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 600px) { .lab-controls { grid-template-columns: 1fr; gap: 20px; }.lab-toolbar { align-items: start; padding: 20px; }.preview-stage { padding: 12px; } }
</style>
