---
import { href } from "../../../config/homework";
import { dataset, type Lang } from "../data";
import { chapters } from "../navigation";
interface Props {
  chapter: Exclude<import("../navigation").PageId, "">;
  lang: Lang;
}
const { chapter, lang } = Astro.props;
const current = chapters.find((c) => c.id === chapter)!;
const en = lang === "en";
const metrics: Record<string, [string, string][]> = {
  industries: [
    [String(dataset.cases.length), en ? "Industry cases" : "产业案例"],
    [String(dataset.capabilities.length), en ? "AI capabilities" : "智能能力"],
  ],
  lab: [
    ["4", en ? "Adjustable parameters" : "可调情景参数"],
    ["2", en ? "Workflows to compare" : "工作方式对照"],
  ],
  sources: [
    [String(dataset.records.length), en ? "Indicator records" : "指标记录"],
    [
      String(dataset.sources.length),
      en ? "Research sources" : "数据与研究来源",
    ],
  ],
};
const image = chapter === "sources" ? "intelligence" : "neural-layers";
---

<header class:list={[ "poster-heading", `poster-${image}`]}>
  <img
    src={href(`images/hw02/${image}.webp`)}
    alt=""
    width="1600"
    height={image === "intelligence" ? 1000 : 900}
    fetchpriority="high"
    decoding="async"
  />
  <div class="poster-title">
    <h1>{current.title[lang]}</h1>
    <p>{current.desc[lang]}</p>
  </div>
  <div class="poster-metrics">
    {metrics[chapter].map(([value, label]) => (
      <div>
        <strong>{value}</strong>
        <span>{label}</span>
      </div>
    ))}
  </div>
</header>
