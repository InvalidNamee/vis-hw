---
import StoryStep from "./StoryStep.astro";
import StoryScene from "./StoryScene.astro";
import type { StoryChapter } from "../story/content";
import type { Lang } from "../content";
interface Props {
  chapter: StoryChapter;
  lang: Lang;
  number: number;
}
const { chapter, lang, number } = Astro.props;
---

<story-chapter
  id={chapter.id}
  data-chapter-id={chapter.id}
  data-lang={lang}
  aria-labelledby={`${chapter.id}-heading`}
>
  <header class="story-chapter-heading">
    <div>
      <span>{String(number).padStart(2, "0")} / 06</span>
      <h2 id={`${chapter.id}-heading`}>{chapter.title[lang]}</h2>
      <p>{chapter.intro[lang]}</p>
    </div>
  </header>
  <div class="story-chapter-grid">
    <div class="story-steps">
      {chapter.steps.map((step, i) => (
        <StoryStep
          step={step}
          lang={lang}
          number={i + 1}
          total={chapter.steps.length}
        />
      ))}
    </div>
    <div class="story-sticky" aria-hidden="true">
      <div class="story-narrative"></div>
      <div class="story-master-scenes">
        <StoryScene
          step={chapter.steps[0]}
          lang={lang}
          instance={`master-${chapter.id}`}
        />
      </div>
      <div class="story-scene-progress" aria-hidden="true">
        {chapter.steps.map((step, i) => (
          <span data-progress-step={step.id}>
            {String(i + 1).padStart(2, "0")}
          </span>
        ))}
      </div>
    </div>
  </div>
  <slot />
</story-chapter>
