---
import { sourceById } from "../data";
import { localizedHref, localeFromUrl } from "../../../i18n";
import ExternalLink from "../../../components/ExternalLink.astro";
interface Props {
  ids: string[];
  note?: string;
}
const { ids, note } = Astro.props;
const en = localeFromUrl(Astro.url) === "en";
---

<div class="source-note">
  <span>{en ? "SOURCE" : "来源"}</span>{" "}
  {ids.map((id) => {
    const s = sourceById(id);
    return (
      <ExternalLink href={s.url}>
        {id === "concept" && en ? "Concept reference" : s.title}
      </ExternalLink>
      <a href={localizedHref(`hw02/sources/#source-${id}`, localeFromUrl(Astro.url))} class="source-definition">{en ? "Definitions" : "口径"}</a>
    );
  })}
  {note && <p>{note}</p>}
</div>
