---
import Chart from "../Chart.astro";
import Choice from "../Choice.astro";
import Source from "../Source.astro";
import { text, formatRecord, type Lang } from "../../data";
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = (z: string, e: string) => text(lang, z, e);
---

<Chart
  kind="adoption"
  title={t("AI 正在进入更多组织", "AI is reaching more organizations")}
  description={t(
    "受访组织使用 AI 的比例 · % · 2023–2025",
    "Surveyed organizations reporting AI use · % · 2023–2025",
  )}
  ids={["hai25", "hai26"]}
  records={["adoption-2023", "adoption-2024", "adoption-2025"]}
  note={t(
    "三次年度调查，样本可能不同；这不是全球所有企业的普及率。选项只筛选已报告的年份。",
    "Annual survey samples may differ; this is not the share of all firms worldwide. Selection focuses reported years only.",
  )}
>
  <div class="chart-controls">
    <Choice
      control="year"
      label={t("聚焦年份", "Focus year")}
      options={["all", "2023", "2024", "2025"].map((value) => ({
        value,
        label: value === "all" ? t("全部", "All") : value,
      }))}
    />
  </div>
</Chart>
<div class="two-col">
  <Chart
    kind="investment"
    title={t("投入的地区差异", "Where private investment goes")}
    description={t(
      "2025 年 AI 私人投资 · 十亿美元 · 所选三个国家",
      "2025 private AI investment · USD billion · three selected countries",
    )}
    ids={["hai26"]}
    records={["investment-us", "investment-cn", "investment-uk"]}
    note={t(
      "不含全部公共投资，也算不上完整的全球排名。",
      "Excludes some public funding; not a complete world ranking.",
    )}
  />
  <Chart
    kind="enterprise"
    title={t("企业越大，采用越普遍？", "How does adoption vary by firm size?")}
    description={t(
      "2025 年欧盟 · 按企业人数分组 · %",
      "EU, 2025 · enterprise size by persons employed · %",
    )}
    ids={["eurostat"]}
    records={["eu-small", "eu-medium", "eu-large"]}
    note={t(
      "覆盖行业中 10 人及以上的企业。与上方 Stanford 的受访组织不是同一个总体，不能直接比较。",
      "Enterprises with 10+ persons in covered sectors. A different population from the Stanford survey above; not directly comparable.",
    )}
  />
</div>

<article class="editorial-card"><p class="hw-kicker">CHINA / CONTEXT</p><h2>{t("投入与部署，是应用的背景","Investment and deployment provide context")}</h2><p>{t(`2025 年中国 AI 核心产业规模约 ${formatRecord("china-scale",lang)} 万亿元，中国占全球工业机器人新增安装量的 ${formatRecord("robots-cn-share",lang)}%。产业规模与机器人安装量衡量的不是一回事，既不能相加，也不能直接算作 AI 带来的收益。`,`China's AI core industry was about CNY ${formatRecord("china-scale",lang)} trillion in 2025, and China accounted for ${formatRecord("robots-cn-share",lang)}% of global industrial robot installations. These measure different dimensions and cannot be added or attributed directly to AI gains.`)}</p><Source ids={["china","ifr"]}/></article>
