---
import Hw02Layout from "./Hw02Layout.astro";
import PosterHeading from "./components/PosterHeading.astro";
import Story from "./story/Story.astro";
import Sources from "./pages/Sources.astro";
import Legacy from "./pages/Legacy.astro";
import { localeFromUrl } from "../../i18n";
import { legacyRoutes, type RouteId } from "./navigation";
const { chapter } = Astro.props as { chapter: RouteId };
const lang = localeFromUrl(Astro.url) === "en" ? "en" : "zh";
---
{chapter in legacyRoutes ? <Legacy chapter={chapter as keyof typeof legacyRoutes} lang={lang}/> : <Hw02Layout chapter={chapter==='sources'?'sources':''}>
 {chapter==='sources'?<div class="chapter-content" data-chapter="sources"><PosterHeading chapter="sources" lang={lang}/><Sources lang={lang}/></div>:<Story lang={lang}/>}
</Hw02Layout>}
