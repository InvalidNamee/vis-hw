---
import Hw02Layout from './Hw02Layout.astro';
import Chart from './components/Chart.astro';
import Source from './components/Source.astro';
import PosterHeading from './components/PosterHeading.astro';
import ExternalLink from '../../components/ExternalLink.astro';
import {dataset,chapters,text,type Lang} from './content';
import {href} from '../../config/homework';
import {localeFromUrl,localizedHref} from '../../i18n';
import {ArrowUpRight,ArrowRight,Download,Layers,Sparkles,MoveUpRight} from '@lucide/astro';
interface Props {chapter:string;}
const {chapter}=Astro.props, locale=localeFromUrl(Astro.url),lang:Lang=locale==='en'?'en':'zh';
const t=(z:string,e:string)=>text(lang,z,e), current=chapters.find(c=>c.id===chapter)!;
const link=(id:string)=>localizedHref(`hw02/${id?`${id}/`:''}`,locale);
const concepts=[['01','劳动者','People','经验与 AI 协作','Experience meets AI','让知识辅助触达更多人，把人的判断用于更复杂的任务。','Make knowledge support accessible; use human judgment for complex tasks.'],['02','劳动资料','Tools','从工具到智能协作','From tools to assistance','把识别、预测和生成能力嵌入设备与软件。','Embed recognition, prediction, and generation in tools.'],['03','劳动对象','Objects of work','数据打开探索空间','Data opens new spaces','处理图像、语言和结构，让更多问题成为可研究、可优化的对象。','Work with images, language, and structures to explore new questions.']];
---
<Hw02Layout chapter={chapter}>
 <div class="chapter-content" data-chapter={chapter}>
 {chapter===''?<>
  <section class="hw-hero">
   <div class="hero-copy hero-poster"><img class="hero-art" src={href('images/hw02/intelligence.webp')} alt="" width="1600" height="1000" fetchpriority="high"/><h1>{t('智变','The intelligence')}<span>{t('从智能，到生产力。','shift.')}</span></h1><p class="hero-lead">{current.desc[lang]}</p><p class="hero-summary">{t('看见技术如何进入产业，理解效率如何产生，亲手探索人机协作的可能。','See technology enter industries. Understand where gains come from. Explore what people and AI can do together.')}</p><a class="hw-primary" href={link('industries')}>{t('探索产业图谱','Explore the atlas')}<ArrowUpRight size={18}/></a><a class="hw-text-link" href={link('lab')}>{t('进入实验室','Enter the lab')}<ArrowRight size={16}/></a><div class="hero-caption">{t('真实数据 / 交互图谱 / 情景实验','REAL DATA / CONNECTED IDEAS / LIVE EXPERIMENTS')}</div></div>
   <Chart kind="hero" title={t('生产力如何发生','How productive change happens')} description={t('选择阶段，追踪技术转化的路径。','Select a stage to trace the transformation.')} class="hero-network">
    <div class="chart-controls stage-tabs">{[t('生产要素','Foundations'),t('智能能力','Capabilities'),t('产业应用','Applications'),t('价值创造','Outcomes')].map((s,i)=><button data-step={i} aria-pressed={i===0?'true':'false'}>{String(i+1).padStart(2,'0')} {s}</button>)}</div>
   </Chart>
  </section>
  <div class="hero-facts">
   <a href={link('trends')}><span>{t('技术走进组织','ADOPTION')}</span><strong>88<small>%</small></strong><p>{t('2025 年受访组织报告使用 AI','Surveyed organizations using AI in 2025')}</p><small>Stanford AI Index 2026 <ArrowUpRight size={13}/></small></a>
   <a href={link('work')}><span>{t('任务效率的实证','EVIDENCE')}</span><strong>+14<small>%</small></strong><p>{t('客服研究：每小时解决问题数','Issues resolved per hour in a support study')}</p><small>NBER · 2023 <ArrowUpRight size={13}/></small></a>
   <a href={link('lab')}><span>{t('从局部到整体','EXPERIMENT')}</span><strong>1<small>{t('个流程',' workflow')}</small></strong><p>{t('调节采用率、加速与复核，观察总工时','Adjust adoption, acceleration, and review')}</p><small>{t('透明假设 · 可复现模拟','Transparent, reproducible simulation')} <ArrowUpRight size={13}/></small></a>
  </div>
  <section class="hw-section"><div class="section-intro"><p class="hw-kicker">RETHINKING PRODUCTIVITY</p><h2>{t('变化，发生在生产要素之间','Change happens between productive factors')}</h2><p>{t('新质生产力关注高科技、高效能、高质量。AI 的意义，在于改变人、工具与工作对象的组合。','New productive forces emphasize technology, efficiency, and quality. AI changes how people, tools, and objects of work fit together.')}</p></div><div class="concept-grid">{concepts.map(c=><article data-story-step={Number(c[0])-1}><span class="concept-number">{c[0]}</span><small>{t(c[1],c[2])}</small><h3>{t(c[3],c[4])}</h3><p>{t(c[5],c[6])}</p></article>)}</div><Source ids={['concept']} note={t('上方网络为机制示意：连线和节点大小不代表经济规模。','The network is a mechanism diagram; links and node sizes do not encode economic magnitude.')}/></section>
  <section class="journey-banner"><Layers size={28}/><div><h2>{t('沿着证据，走完这条路径','Follow the evidence')}</h2><p>{t('从发展趋势出发，进入产业，检查研究，最后自己做一次实验。','Start with adoption, explore industries, examine studies, then run your own experiment.')}</p></div><a class="hw-primary" href={link('trends')}>{t('开始探索','Begin exploring')}<ArrowRight size={17}/></a></section>
 </>:<PosterHeading chapter={chapter} lang={lang}/>}

 {chapter==='trends'&&<>
  <Chart kind="pathway" class="explanation-graph" title={t('从技术投入，到实际产出','From investment to useful output')} description={t('点击图中环节，理解投入如何进入生产。机制示意，连线不表示资金流量。','Select a stage to explore how investment reaches production. A mechanism diagram, not a financial flow.')} ids={['hai25','concept']}/>
  <Chart kind="adoption" title={t('AI 正在进入更多组织','AI is reaching more organizations')} description={t('受访组织使用 AI 的比例 · % · 2023–2025','Surveyed organizations reporting AI use · % · 2023–2025')} ids={['hai25','hai26']} records={['adoption-2023','adoption-2024','adoption-2025']} note={t('三次年度调查，样本可能变化；不是全球所有企业的普及率。框选只筛选实际年份，不生成中间数据。','Annual survey samples may differ; this is not the share of all firms worldwide. Brushing selects reported years only.')}>
   <div class="chart-controls"><label>{t('聚焦年份','Focus year')} <select data-control="year" data-hw02-control><option value="all">{t('全部年份','All years')}</option>{[2023,2024,2025].map(y=><option value={y}>{y}</option>)}</select></label><button data-action="reset">{t('重置范围','Reset range')}</button><span class="control-hint">{t('拖动图下方的选择框','Drag the range selector below')}</span></div>
  </Chart>
  <div class="two-col"><Chart kind="investment" title={t('投入的地区差异','Where private investment goes')} description={t('2024 年 AI 私人投资 · 十亿美元 · 所选三国','2024 private AI investment · USD billion · three selected countries')} ids={['hai25']} records={['investment-us','investment-cn','investment-uk']} note={t('不含所有公共投资，不构成完整的全球排名。','Excludes some public funding; not a complete world ranking.')}><div class="chart-controls"><label>{t('排列方式','Sort')} <select data-control="sort" data-hw02-control><option value="desc">{t('从高到低','Highest first')}</option><option value="asc">{t('从低到高','Lowest first')}</option></select></label></div></Chart>
  <article class="editorial-card"><p class="hw-kicker">READ THE DIFFERENCE</p><h2>{t('三个不同的问题','Three different questions')}</h2>{[[t('投入','Investment'),t('有多少资源进入 AI？','How many resources go into AI?')],[t('采用','Adoption'),t('有多少组织开始使用？','How many organizations use it?')],[t('生产率','Productivity'),t('相同投入能否带来更多、更好的产出？','Can the same inputs produce more or better output?')]].map((a,i)=><div class="reading-row"><b>0{i+1}</b><div><h3>{a[0]}</h3><p>{a[1]}</p></div></div>)}<a class="hw-text-link" href={link('work')}>{t('查看生产率研究','Examine productivity evidence')}<ArrowRight size={16}/></a></article></div>
 </>}

 {chapter==='industries'&&<>
  <Chart kind="industry" title={t('连接能力与产业','Connect capabilities to industries')} description={t('点击节点，查看关联能力与产业案例。','Select a node to explore connected capabilities and industry cases.')} note={undefined}>
   <div class="chart-controls"><label>{t('选择产业','Industry')} <select data-control="industry" data-hw02-control>{dataset.cases.map(c=><option value={c.id}>{c.name[lang]}</option>)}</select></label><div class="segmented"><button data-view="network" aria-pressed="true">{t('关系网络','Network')}</button><button data-view="matrix" aria-pressed="false">{t('能力矩阵','Matrix')}</button></div><button data-action="reset">{t('重置视图','Reset view')}</button></div>
   <div class="legend"><span><i class="dot blue"></i>{t('产业','Industry')}</span><span><i class="dot mint"></i>{t('AI 能力','AI capability')}</span><span>{t('连线表示应用关系，不表示强度','Links show applications, not their strength')}</span></div>
  </Chart>
  <div class="case-collection">{dataset.cases.map((c,i)=><article class="case-detail" data-case={c.id} hidden={i!==0}><div class="case-heading"><span class="hw-kicker">{String(i+1).padStart(2,'0')} / {c.name[lang]}</span><h2>{c.task[lang]}</h2><p>{c.meaning[lang]}</p></div><div class="flow-comparison"><div><small>{t('传统流程 · 示意','CONVENTIONAL · SCHEMATIC')}</small><ol>{c.before[lang].map(v=><li>{v}</li>)}</ol></div><div><small>{t('AI 协作流程 · 示意','AI-ASSISTED · SCHEMATIC')}</small><ol class="ai-flow">{c.after[lang].map(v=><li>{v}</li>)}</ol></div></div><Source ids={[c.source]} note={c.limit[lang]}/></article>)}</div>
  <div class="insight-strip"><MoveUpRight size={20}/><p>{t('共同点：把感知、预测或生成能力放入具体流程。差异：每个行业的验证条件与人的责任都不同。','The common thread is a capability embedded in a workflow. Validation and human responsibility differ by industry.')}</p></div>
 </>}

 {chapter==='work'&&<>
  <Chart kind="collaboration" class="explanation-graph" title={t('知识如何到达一个工作现场','How knowledge reaches the workplace')} description={t('沿着关系图，观察知识、AI 与人的分工。点击节点展开说明。','Follow the connections between knowledge, AI, and human judgment. Select a node for details.')} ids={['nber']} note={t('基于客服辅助场景的机制图；连线不表示研究测得的效应大小。','A mechanism diagram for AI-assisted support; links do not encode measured effect sizes.')}/>
  <Chart kind="effects" title={t('任务中的变化，可以被测量','Measurable changes in specific tasks')} description={t('各研究基准 = 100；选择指标，比较同一研究内的变化。','Baseline = 100 within each study. Select an outcome for a within-study comparison.')} ids={['nber','writing']} records={['support','novice','time','quality']} note={t('指数由报告的相对变化换算。各研究的基准、样本和结果不同，不能按指数排名或求平均。','Indices are derived from reported relative changes. Different studies and outcomes cannot be ranked or averaged together.')}>
   <div class="chart-controls"><label>{t('研究指标','Study outcome')} <select data-control="effect" data-hw02-control>{dataset.records.filter(r=>['support','time','quality'].includes(r.id)).map(r=><option value={r.id}>{r.label[lang]}</option>)}</select></label></div>
  </Chart>
  <div class="two-col"><Chart kind="skills" title={t('帮助并非均匀分布','The gains are not evenly shared')} description={t('客服研究：每小时解决问题数相对变化 · %','Support study: change in issues resolved per hour · %')} ids={['nber']} records={['support','novice']} note={t('新手与低技能组是总体样本的子集，不能当作独立组与总体相加。资深组缺少此处可用的精确数值，未绘制。','The novice/low-skilled group is a subset of the overall sample; these values are not additive. No precise experienced-group estimate is plotted.')} />
  <article class="editorial-card"><p class="hw-kicker">WHAT THIS MEANS</p><h2>{t('让知识更容易被使用','Make knowledge easier to use')}</h2><p>{t('AI 辅助可能帮助经验较少的员工调用已有知识。效果取决于任务、工具与工作环境。','AI assistance can help less experienced workers access existing knowledge. Effects depend on tasks, tools, and context.')}</p><div class="quote-note">{t('一个客服样本的收益，不是所有岗位的未来。','One support sample does not predict the future of every job.')}</div><h3>{t('读研究时，先问三件事','Ask three questions')}</h3><ul><li>{t('测量的是时间、数量，还是质量？','Does it measure time, quantity, or quality?')}</li><li>{t('对谁有效，在哪种任务里？','For whom, and in which tasks?')}</li><li>{t('复核与学习成本是否被计入？','Are review and learning costs included?')}</li></ul></article></div>
 </>}

 {chapter==='lab'&&<>
  <div class="insight-strip"><Sparkles size={20}/><p>{t('情景模拟 · 不是现实预测。比较相同任务量，只有“内容生产”阶段接受 AI 加速。','SCENARIO SIMULATION · Not a forecast. Equal workloads; AI accelerates only the production stage.')}</p></div>
  <Chart kind="lab" title={t('一个流程，两种工作方式','One workflow. Two ways to work.')} description={t('调整参数，比较串行任务的总工时。动画使用同一时间比例。','Adjust the parameters to compare serial task effort. Both animations use the same time scale.')}>
   <div class="lab-controls">{[
    ['tasks',t('任务数量','Number of tasks'),1,100,20,1,t('项','tasks')],['adoption',t('AI 参与比例','AI participation'),0,100,60,5,'%'],['speed',t('参与任务加速倍率','Speed-up on AI tasks'),1,8,3,0.5,'×'],['review',t('每项额外复核','Extra review per task'),0,30,4,1,t('分钟','min')]
   ].map(([key,label,min,max,value,step,unit])=><label>{label}<span><output data-output={key}>{value}</output> {unit}</span><input data-hw02-control data-control={key} aria-label={String(label)} type="range" min={min} max={max} value={value} step={step}/></label>)}</div>
   <div class="lab-results" aria-live="polite"><div><span>{t('原流程','BASELINE')}</span><strong data-result="baseline">—</strong></div><div><span>{t('AI 协作','AI-ASSISTED')}</span><strong data-result="assisted">—</strong></div><div><span>{t('节省工时比例','EFFORT SAVED')}</span><strong data-result="saved">—</strong></div></div>
   <div class="chart-controls"><button data-action="play" class="hw-primary">{t('播放流程','Play workflow')}</button><button data-action="replay">{t('重新播放','Replay')}</button><button data-action="reset">{t('恢复默认','Reset')}</button><button data-action="share">{t('复制情景链接','Copy scenario link')}</button><label>{t('播放速度','Playback speed')} <select data-control="playback" data-hw02-control><option value="1">1×</option><option value="2">2×</option><option value="4">4×</option></select></label></div>
  </Chart>
  <Chart kind="sensitivity" title={t('何时，才能真正节省工时？','When does acceleration pay off?')} description={t('跟随上方参数，查看 AI 参与比例与总工时的关系。','Using the parameters above, compare AI participation with total effort.')}><div class="legend"><span><i class="dot blue"></i>{t('AI 情景','AI scenario')}</span><span><i class="dot gray"></i>{t('原流程','Baseline')}</span></div></Chart>
  <details class="method-panel" open><summary>{t('模型假设与计算方法','Model assumptions and calculation')}</summary><div class="method-content"><p>{t('每项任务：需求整理 10 分钟、内容生产 30 分钟、原有复核 10 分钟、交付 5 分钟。AI 只加速内容生产；额外复核 r 对每项任务都计入。所有时间均为教学假设。','Each task: briefing 10 min, production 30 min, existing review 10 min, delivery 5 min. AI accelerates production only; extra review r applies to every task. All times are teaching assumptions.')}</p><code>T = n × [10 + 30 × (1 − a + a / s) + 10 + r + 5]</code><p>{t('n 为任务数，a 为参与比例，s 为加速倍率。模型不包含并行、质量变化或经济收益；最长阶段只表示耗时重点，不等于并行产线瓶颈。','n = task count, a = participation, s = speed-up. This model excludes parallelism, quality changes, and economic returns. The longest stage is an effort concentration, not a parallel-system bottleneck.')}</p></div></details>
 </>}

 {chapter==='transition'&&<>
  <Chart kind="infrastructure" class="explanation-graph" title={t('一次智能服务，背后的资源网络','The resources behind an AI service')} description={t('电力、算力与数据共同支撑应用。点击节点查看它的作用。','Power, compute, and data support applications. Select a node to explore its role.')} ids={['iea','worldbank']} note={t('基础设施关系示意；路径宽度不代表能源消耗比例。','Infrastructure schematic; path widths do not represent energy shares.')}/>
  <Chart kind="energy" title={t('智能背后，是物理基础设施','Intelligence has a physical footprint')} description={t('全球全部数据中心用电 · TWh · IEA 2025 报告版本','Global electricity use of all data centres · TWh · IEA 2025 edition')} ids={['iea']} records={['energy-2024','energy-2030']} note={t('415 TWh 为 2024 年历史估计；945 TWh 为 2030 年基准情景预测。数据中心包含多种负载，不能全部归因于 AI。','415 TWh is the 2024 historical estimate; 945 TWh is the 2030 Base Case projection. Data centres host many workloads, not AI alone.')}><div class="chart-controls"><label>{t('展示口径','Display')} <select data-control="energy" data-hw02-control><option value="absolute">{t('绝对用电量','Absolute electricity use')}</option><option value="index">{t('2024 = 100 指数','Index: 2024 = 100')}</option></select></label></div></Chart>
  <section class="hw-section"><div class="section-intro"><p class="hw-kicker">FOUNDATIONS FOR PROGRESS</p><h2>{t('把条件补齐，让收益发生','Build the conditions for gains')}</h2><p>{t('以下是机制解释，不是国家或行业评分。','These are mechanisms, not scores assigned to countries or industries.')}</p></div><div class="foundation-grid">{[
   [t('数据与连接','Data & connectivity'),t('可用的数据，稳定的基础设施','Usable data, dependable infrastructure'),t('数据质量影响结果，连接能力影响谁能够使用。','Data quality shapes outputs; connectivity shapes access.')],
   [t('人才与组织','Skills & organizations'),t('学会使用，也重设工作流程','Learn the tools, redesign the work'),t('培训、职责与复核机制，让新工具进入日常生产。','Training, ownership, and review bring new tools into daily work.')],
   [t('能源与效率','Energy & efficiency'),t('同时考虑收益与资源消耗','Account for gains and resources'),t('高效模型与合理部署，是降低基础设施压力的路径。','Efficient models and deployment can ease infrastructure demands.')]
  ].map((a,i)=><article><span class="concept-number">0{i+1}</span><h3>{a[0]}</h3><strong>{a[1]}</strong><p>{a[2]}</p></article>)}</div><Source ids={['worldbank','iea']}/></section>
  <section class="journey-banner"><Sparkles size={26}/><div><h2>{t('意义，在于更好的生产与创造','The goal is better production and creation')}</h2><p>{t('用证据判断收益，用实验理解机制，用设计让更多人看懂变化。','Use evidence to assess gains, experiments to understand mechanisms, and design to make change legible.')}</p></div><a class="hw-text-link" href={link('sources')}>{t('检查所有来源','Inspect the sources')}<ArrowRight size={17}/></a></section>
 </>}

 {chapter==='sources'&&<>
  <section class="image-credits" id="artwork"><h2>{t('视觉素材 / Visualising AI','Visual artwork / Visualising AI')}</h2><div>{[
   ['intelligence','https://unsplash.com/photos/a-close-up-of-a-blue-and-purple-object-tawZVa3EBXQ','Twistedpoly'],
   ['neural-layers','https://unsplash.com/photos/a-close-up-of-several-blue-pills-_HnJfS6WhA8','Rose Pilkington']
  ].map(([file,url,artist])=><article><img src={href(`images/hw02/${file}.webp`)} alt={t('AI 主题艺术配图','AI-themed artwork')} width="160" height="90" loading="lazy"/><div><ExternalLink href={url}>{artist} / Google DeepMind</ExternalLink><p>{t('概念艺术配图，非实测数据图。','Conceptual artwork, not a measured data visualization.')} <ExternalLink href="https://unsplash.com/license">Unsplash License</ExternalLink></p></div></article>)}</div></section>
  <div class="download-bar"><div><strong>{t('开放数据笔记','Open data notebook')}</strong><p>{t('12 个指标记录 · 5 个产业案例 · 11 个来源','12 indicator records · 5 industry cases · 11 sources')}</p></div><a download href={href('data/hw02/indicators.csv')}><Download size={17}/> CSV</a><a download href={href('data/hw02/dataset.json')}><Download size={17}/> JSON</a></div>
  <ai-viz class="viz-card" data-kind="sources" data-lang={lang}><div class="chart-controls"><label class="search-label">{t('检索来源','Search sources')}<input type="search" data-control="search" data-hw02-control placeholder={t('机构、标题或口径…','Organization, title, or scope…')}/></label><span data-count aria-live="polite"></span></div><div class="source-list">{dataset.sources.map((s,i)=><article data-source-row><span>{String(i+1).padStart(2,'0')}</span><div><h2><ExternalLink href={s.url}>{s.id==='concept'&&lang==='en'?'New quality productive forces · Concept reference':s.title}</ExternalLink></h2><small>{s.section} · {t('检索于','Retrieved')} {s.retrieved}</small><p>{s.note[lang]}</p></div></article>)}</div><p data-status class="chart-status" aria-live="polite"></p></ai-viz>
  <div class="two-col"><article class="editorial-card"><p class="hw-kicker">DATA DICTIONARY</p><h2>{t('先看口径，再看数字','Read the definition before the number')}</h2><dl><dt>{t('观测与研究结果','Observations & study results')}</dt><dd>{t('对应特定样本、时期和任务，不表示普遍规律。','Bound to a sample, period, and task; not a universal law.')}</dd><dt>{t('历史估计与情景预测','Estimates & projections')}</dt><dd>{t('历史估计仍有不确定性；未来情景依赖模型假设。','Historical estimates have uncertainty; future projections depend on assumptions.')}</dd><dt>{t('机制图与模拟','Mechanisms & simulations')}</dt><dd>{t('关系图为编辑整理；实验室的参数是假设，不混入观测数据。','Connections are editorial synthesis; lab parameters are assumptions, separate from observations.')}</dd></dl></article>
  <article class="editorial-card"><p class="hw-kicker">D3 / UNDER THE HOOD</p><h2>{t('数据，如何成为图形','How data becomes a visual')}</h2><p>{t('比例尺把数值映射到坐标；轴给出参照；数据绑定让每个图形对应稳定的记录。','Scales map values to positions; axes provide reference; data joins keep records attached to their marks.')}</p><ul><li><code>selection.join</code> — {t('数据与图形对应','bind records to marks')}</li><li><code>scale / axis / shape</code> — {t('量化、参照与几何','encoding, reference, geometry')}</li><li><code>selection.on / SVG path</code> — {t('固定关系图、图解与点击联动','fixed relationship diagrams, illustrations, and linked selection')}</li><li><code>brush / transition / timer</code> — {t('筛选与连续变化','selection and continuous change')}</li></ul><ExternalLink href="https://d3js.org/">{t('D3 官方文档','D3 documentation')}</ExternalLink></article></div>
  <details class="method-panel"><summary>{t('查看实际实现片段：稳定的数据绑定','Implementation excerpt: stable data joins')}</summary><div class="method-content"><pre><code>{`svg.selectAll('circle.point')\n  .data(records, d => d.id)\n  .join('circle')\n  .attr('class', 'point')\n  .attr('cx', d => x(d.period))\n  .attr('cy', d => y(d.value));`}</code></pre><p>{t('采用率图使用记录 ID 作为键，筛选年份时保留同一条数据与图形的对应关系。','The adoption chart uses record IDs as keys so filtering preserves the association between each record and its mark.')}</p></div></details>
