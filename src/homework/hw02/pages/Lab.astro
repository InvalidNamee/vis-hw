---
import Chart from "../components/Chart.astro";
import Choice from "../components/Choice.astro";
import { text, type Lang } from "../data";
import { calculate, defaults } from "../model.mjs";
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const initial = calculate(defaults);
const t = (z: string, e: string) => text(lang, z, e);
---


<Chart
  kind="lab"
  title={t("一个流程，两种工作方式", "One workflow. Two ways to work.")}
  description={t(
    "教学模拟：仅生产阶段加速，计入额外复核。两条流程使用同一时间比例。",
    "Teaching simulation: only production accelerates; extra review is included. Both workflows use the same time scale.",
  )}
>
  <div class="chart-controls preset-controls">
    <span>{t("教学情景", "Teaching scenarios")}</span>
    {[
      ["low-review", t("低复核成本", "Low review")],
      ["high-review", t("高复核成本", "High review")],
      ["low-adoption", t("低参与比例", "Low participation")],
    ].map(([id, label]) => (
      <button data-preset={id} aria-pressed="false">
        {label}
      </button>
    ))}
    <small data-preset-label></small>
  </div>
  <div class="lab-controls">
    {[
      [
        "tasks",
        t("任务数量", "Number of tasks"),
        1,
        100,
        20,
        1,
        t("项", "tasks"),
      ],
      ["adoption", t("AI 参与比例", "AI participation"), 0, 100, 60, 5, "%"],
      [
        "speed",
        t("参与任务加速倍率", "Speed-up on AI tasks"),
        1,
        8,
        3,
        0.5,
        "×",
      ],
      [
        "review",
        t("每项额外复核", "Extra review per task"),
        0,
        30,
        4,
        1,
        t("分钟", "min"),
      ],
    ].map(([key, label, min, max, value, step, unit]) => (
      <label>
        {label}
        <span>
          <output data-output={key}>{value}</output> {unit}
        </span>
        <input
          data-hw02-control
          data-control={key}
          aria-label={String(label)}
          type="range"
          min={min}
          max={max}
          value={value}
          step={step}
        />
      </label>
    ))}
  </div>
  <div class="lab-results">
    <div>
      <span>{t("原流程", "BASELINE")}</span>
      <strong data-result="baseline">{(initial.baseTotal/60).toFixed(1)} {t("小时","h")}</strong>
    </div>
    <div>
      <span>{t("AI 协作", "AI-ASSISTED")}</span>
      <strong data-result="assisted">{(initial.aiTotal/60).toFixed(1)} {t("小时","h")}</strong>
    </div>
    <div>
      <span>{t("节省工时比例", "EFFORT SAVED")}</span>
      <strong data-result="saved">{initial.saved.toFixed(1)}%</strong>
    </div>
  </div>
  <div class="chart-controls" slot="after">
    <button data-action="play" class="hw-primary">
      {t("播放流程", "Play workflow")}
    </button>
    <button data-action="reset">{t("恢复默认", "Reset")}</button>
    <button data-action="share">
      {t("复制情景链接", "Copy scenario link")}
    </button>
    <button data-action="demo" aria-pressed="false">{t("演示三个情景", "Demonstrate scenarios")}</button>
    <button data-action="demo-replay">{t("重播情景", "Replay scenarios")}</button>
    <span data-demo-status aria-live="polite"></span>
    <Choice
      control="playback"
      label={t("播放速度", "Playback speed")}
      options={["1", "2", "4"].map((value) => ({ value, label: `${value}×` }))}
    />
  </div>
</Chart>
<div class="lab-context">
  <Chart
    kind="sensitivity"
    title={t("何时，才能真正节省工时？", "When does acceleration pay off?")}
    description={t(
      "跟随上方参数，查看 AI 参与比例与总工时的关系。",
      "Using the parameters above, compare AI participation with total effort.",
    )}
  >
    <div class="legend">
      <span>
        <i class="dot blue"></i>
        {t("AI 情景", "AI scenario")}
      </span>
      <span>
        <i class="dot gray"></i>
        {t("原流程", "Baseline")}
      </span>
    </div>
  </Chart>
  <details class="method-panel" open>
    <summary>
      {t("模型假设与计算方法", "Model assumptions and calculation")}
    </summary>
    <div class="method-content">
      <p>
        {t(
          "每项任务：需求整理 10 分钟、内容生产 30 分钟、原有复核 10 分钟、交付 5 分钟。AI 只加速内容生产；额外复核 r 对每项任务都计入。所有时间均为教学假设。",
          "Each task: briefing 10 min, production 30 min, existing review 10 min, delivery 5 min. AI accelerates production only; extra review r applies to every task. All times are teaching assumptions.",
        )}
      </p>
      <code>T = n × [10 + 30 × (1 − a + a / s) + 10 + r + 5]</code>
      <p>
        {t(
          "n 为任务数，a 为参与比例，s 为加速倍率。模型不包含并行、质量变化或经济收益；最长阶段只表示耗时重点，不等于并行产线瓶颈。",
          "n = task count, a = participation, s = speed-up. This model excludes parallelism, quality changes, and economic returns. The longest stage is an effort concentration, not a parallel-system bottleneck.",
        )}
      </p>
    </div>
  </details>
</div>
