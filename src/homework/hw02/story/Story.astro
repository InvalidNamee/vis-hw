---
import { href } from "../../../config/homework";
import { localizedHref, localeFromUrl } from "../../../i18n";
import { type Lang } from "../data";
import { storyChapters } from "./content";
import { presentationFor } from "./presentation";
import Source from "../components/Source.astro";
import Industries from "../pages/Industries.astro";
import Benefits from "../components/sections/Benefits.astro";
import Momentum from "../components/sections/Momentum.astro";
import Boundaries from "../components/sections/Boundaries.astro";
import Lab from "../pages/Lab.astro";
import { ArrowDown, ArrowUpRight } from "@lucide/astro";
const { lang } = Astro.props as { lang: Lang };
const t = (zh: string, en: string) => (lang === "en" ? en : zh);
const explorers = {
  capabilities: Industries,
  evidence: Benefits,
  diffusion: Momentum,
  conditions: Boundaries,
  experiment: Lab,
};
const values = [
  [
    t("效率", "Efficiency"),
    t(
      "把生产、学习与复核的成本一起算进去。",
      "Account for production, learning and review costs.",
    ),
  ],
  [
    t("质量", "Quality"),
    t(
      "在具体任务上检验结果，判断仍由人来做。",
      "Evaluate specific tasks and retain human judgment.",
    ),
  ],
  [
    t("创新", "Innovation"),
    t(
      "先拓展可探索的空间，再用实验确认发现。",
      "Expand the search space, then validate discoveries.",
    ),
  ],
];
---

<header class="story-cover" id="opening">
  <img src={href("images/hw02/intelligence.webp")} width="1600" height="1000" alt="" fetchpriority="high" />
  <canvas class="cover-field" data-cover-field aria-hidden="true"></canvas>
  <div class="poster-hud" aria-hidden="true">
    <span>HW—02</span><span>{t("人工智能 × 新质生产力", "AI × PRODUCTIVE FORCES")}</span><span>N 39.9° / E 116.4°</span><span>{storyChapters.length} CH · {storyChapters.reduce((n, c) => n + c.steps.length, 0)} STEPS</span>
  </div>
  <div class="story-cover-copy">
    <h1>
      <span class="cover-title">{t("智变", "The intelligence shift")}</span>
      <span class="cover-subtitle">{t("人工智能，怎样成为新质生产力？", "How does AI become a productive force?")}</span>
    </h1>
    <p>{t(
      "从一个工作现场出发，走进五个产业，用证据检验变化，最后亲手做一次效率实验。",
      "Begin with a working day. Explore five industries, examine the evidence, and run your own productivity experiment.",
    )}</p>
    <a class="hw-primary" href="#workplace">
      {t("向下滚动，开始探索", "Scroll to explore")}<ArrowDown size={18} aria-hidden="true" />
    </a>
    <span class="story-reading">{t(
      "六章 · 主线约 8–12 分钟 · 可随时探索",
      "Six chapters · about 8–12 minutes · explore at your own pace",
    )}</span>
  </div>
  <div class="cover-index">
    {storyChapters.map((chapter, index) => (
      <a href={`#${chapter.id}`}>
        <span>0{index + 1}</span>{chapter.title[lang]}<ArrowUpRight size={15} aria-hidden="true" />
      </a>
    ))}
  </div>
</header>

{storyChapters.map((chapter, index) => {
  const Explore = explorers[chapter.id as keyof typeof explorers];
  const presentation = presentationFor(chapter, lang);
  return (
    <section class="story-chapter" id={chapter.id} data-story-chapter data-layout={presentation.layout} data-family={presentation.family}>
      <header class="story-chapter-heading" data-poster>
        <span class="poster-number" aria-hidden="true">0{index + 1}</span>
        <span class="poster-slab" aria-hidden="true"></span>
        <span class="chapter-position">{t(`第 ${index + 1} 章`, `Chapter ${index + 1}`)}</span>
        <h2 data-poster-title>{chapter.title[lang]}</h2>
        <p>{chapter.intro[lang]}</p>
        <dl class="poster-meta" aria-hidden="true">
          <div><dt>STEPS</dt><dd>{String(chapter.steps.length).padStart(2, "0")}</dd></div>
          <div><dt>SOURCES</dt><dd>{String(new Set(chapter.steps.flatMap((s) => s.sources)).size).padStart(2, "0")}</dd></div>
          <div><dt>MODE</dt><dd>{presentation.family.toUpperCase()}</dd></div>
        </dl>
        <div class="poster-marquee" aria-hidden="true"><div>
          {[0, 1].map(() => chapter.steps.map((s) => <span>{s.title[lang]}<i>◆</i></span>))}
        </div></div>
      </header>
      <story-scene data-chapter={chapter.id} data-lang={lang} data-layout={presentation.layout} data-family={presentation.family}>
        <div class="story-viewport">
        <div class="story-stage" aria-hidden="true">
          <i class="stage-corner" data-corner="tl"></i><i class="stage-corner" data-corner="tr"></i><i class="stage-corner" data-corner="bl"></i><i class="stage-corner" data-corner="br"></i>
          <div class="story-stage-heading">
            <p>{presentation.label}</p><span data-scene-number>1 / {chapter.steps.length}</span>
          </div>
          <div class="story-plot"><div class="scene-placeholder" aria-hidden="true"><i></i><i></i><i></i></div></div>
          <p class="story-stage-caption" data-scene-caption></p>
          <div class="scene-progress"><i></i></div>
        </div>
        </div>
        <div class="story-steps">
          {chapter.steps.map((step, stepIndex) => (
            <article class="story-step" id={step.id} data-step={stepIndex}>
              <div class="story-step-copy">
                <span class="step-number">0{index + 1} / {String(stepIndex + 1).padStart(2, "0")}</span>
                <h3>{step.title[lang]}</h3>
                <p>{step.body[lang]}</p>
                {step.sources.length > 0 && <Source ids={step.sources} />}
                <div class="step-static" data-static-scene={step.scene}></div>
              </div>
            </article>
          ))}
        </div>
      </story-scene>
      <section class="story-explore" id={chapter.explore}>
        <div class="explore-heading">
          <div>
            <h3>{index === 0
              ? t("效率、质量、创新", "Efficiency, quality, innovation")
              : t("停下来，看得再深一些", "Pause and look closer")}</h3>
          </div>
          <a href={`#${storyChapters[index + 1]?.id ?? "conclusions"}`} class="hw-text-link">
            {t("继续往下", "Continue")}<ArrowDown size={16} aria-hidden="true" />
          </a>
        </div>
        {Explore ? (
          <details class="explore-disclosure" open={index === 5}>
            <summary>{index === 5
              ? t("调整参数，跑一次你的实验", "Adjust parameters and run your experiment")
              : t("展开完整图表与控件", "Open the full charts and controls")}</summary>
            <div class="explore-content"><Explore lang={lang} /></div>
          </details>
        ) : (
          <div class="overview-values">
            {values.map(([title, body]) => <article><h3>{title}</h3><p>{body}</p></article>)}
          </div>
        )}
      </section>
    </section>
  );
})}

<section class="story-conclusion" id="conclusions">
  <canvas class="cover-field" data-cover-field data-mode="grid" aria-hidden="true"></canvas>
  <h2>{t("问题不再是“能做什么”，而是“怎样做好”。", "From what AI can do, to how we do it well.")}</h2>
  <p>{t(
    "效率来自整条流程的改善，质量来自持续验证，创新来自探索与实验。技术能否兑现潜力，取决于数据、组织，以及人是否担起责任。",
    "Efficiency comes from improving the whole workflow, quality from evaluation, and innovation from exploration and experiments. Data, organizations and human responsibility help realize the potential.",
  )}</p>
  <div>
    <a class="hw-primary" href={localizedHref("hw02/sources/", localeFromUrl(Astro.url))}>
      {t("查看数据与方法", "Data & methods")}<ArrowUpRight size={18} aria-hidden="true" />
    </a>
    <a class="hw-text-link" href="#opening">{t("从头再看", "Start again")}</a>
  </div>
</section>
<script>
  import "./controller";
  import "./poster";
</script>
