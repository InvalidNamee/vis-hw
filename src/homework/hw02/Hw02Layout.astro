---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import { getHomework } from "../../config/homework";
import { localeFromUrl, localizedHref, translate } from "../../i18n";
import { chapters, type PageId } from "./navigation";
import { storyChapters } from "./story/content";
import { List, ArrowUpRight } from "@lucide/astro";
import "./styles/theme.css";
import "./styles/layout.css";
import "./styles/components.css";
import "./styles/topics.css";
import "./styles/story.css";
const { chapter } = Astro.props as { chapter: PageId };
const locale = localeFromUrl(Astro.url),
  lang = locale === "en" ? "en" : "zh";
const current = chapters.find((c) => c.id === chapter)!;
const t = (zh: string, en: string) => (lang === "en" ? en : zh);
const home = localizedHref("hw02/", locale);
const homeworkTitle = translate(locale, getHomework("hw02").title);
const pageTitle = chapter === "" ? homeworkTitle : `${current.name[lang]} · ${homeworkTitle}`;
---
<BaseLayout title={pageTitle} description={current.desc[lang]} current="hw02" variant="workspace">
 <hw02-shell class="hw-shell hw-story-shell" data-lang={lang}>
  <nav class="story-nav" aria-label={t('HW02 章节导航','HW02 chapters')}>
   <a href={home} class="story-wordmark">{t('智变','AI / SHIFT')}</a>
   <span class="story-current" data-story-current>{t('人工智能与新质生产力','AI and productive forces')}</span>
   <details class="story-menu"><summary><List size={16}/>{t('目录','Contents')}</summary><div>{storyChapters.map((c,i)=><a href={`${chapter===''?'':home}#${c.id}`} data-chapter-link={c.id}><span>0{i+1}</span>{c.title[lang]}</a>)}<a href={localizedHref('hw02/sources/',locale)}>{t('数据与方法','Data & methods')}</a></div></details>
   <a class="story-source-link" href={localizedHref('hw02/sources/',locale)}>{t('来源','Sources')}<ArrowUpRight size={14}/></a>
   <div class="story-total-progress" aria-hidden="true"><i data-story-progress></i></div>
  </nav>
  <div class:list={['hw-main',{'story-data-page':chapter==='sources'}]}><slot/><SiteFooter/></div>
 </hw02-shell>
 <script>import './interactions/lazy-charts'; import './story/navigation';</script>
</BaseLayout>
