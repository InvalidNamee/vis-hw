---
import ArticleLayout from './ArticleLayout.astro';
import { getHomework } from '../config/homework';
import type { TocEntry } from '../components/TableOfContents.astro';
interface Props { frontmatter: { homework: string; toc?: TocEntry[]; }; }
const { frontmatter } = Astro.props;
const hw = getHomework(frontmatter.homework);
---
<ArticleLayout title={hw.title} description={hw.description} current={hw.id} eyebrow={hw.id.toUpperCase()} toc={frontmatter.toc}>
  <slot />
</ArticleLayout>
