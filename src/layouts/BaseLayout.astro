---
import { translator, localeFromUrl } from '../i18n';
const t = translator(Astro.url);
const locale = localeFromUrl(Astro.url);
import '../styles/global.css';
import { href } from '../config/homework';
import FloatingNavigation from '../components/FloatingNavigation.astro';
import SiteFooter from '../components/SiteFooter.astro';
interface Props { title: string; description?: string; current?: string; variant?: 'default' | 'workspace' | 'exhibition'; }
const { title, description = t("《可视化导论》课程作业：从网页基础到数据可视化。"), current, variant = 'default' } = Astro.props;
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <script is:inline>
      (() => {
        let saved = null;
        try { saved = localStorage.getItem('vis-hw-theme'); } catch {}
        const dark = saved === 'dark' || (saved !== 'light' && matchMedia('(prefers-color-scheme: dark)').matches);
        document.documentElement.classList.toggle('dark', dark);
        document.documentElement.dataset.theme = dark ? 'dark' : 'light';
      })();
    </script>
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={href('favicon.svg')} />
    <title>{title} · {t("可视化导论")}</title>
  </head>
  <body class:list={{'site-workspace': variant === 'workspace','site-exhibition':variant==='exhibition'}}>
    <a class="skip-link" href="#main">{t("跳到正文")}</a>
    <FloatingNavigation current={current} />
    <main id="main"><slot /></main>
    {variant === 'default' && <SiteFooter />}
  </body>
</html>
