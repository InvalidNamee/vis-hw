---
import '../styles/global.css';
import { homework, href } from '../config/homework';
import ExternalLink from '../components/ExternalLink.astro';
interface Props { title: string; description?: string; current?: string; }
const { title, description = '《可视化导论》课程作业：从网页基础到数据可视化。', current } = Astro.props;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={href('favicon.svg')} />
    <title>{title} · 可视化导论</title>
  </head>
  <body>
    <a class="skip-link" href="#main">跳到正文</a>
    <header class="site-header">
      <div class="nav-shell">
        <a class="brand" href={href()} aria-current={!current ? 'page' : undefined}>可视化导论</a>
        <nav class="desktop-nav" aria-label="作业导航">
          {homework.map(hw => <a href={href(`${hw.id}/`)} aria-current={current === hw.id ? 'page' : undefined}>{hw.id.toUpperCase()}</a>)}
        </nav>
        <details class="mobile-nav">
          <summary>{current?.startsWith('hw') ? `${current.toUpperCase()} · 切换作业` : '选择作业'}</summary>
          <nav aria-label="移动端作业导航">{homework.map(hw => <a href={href(`${hw.id}/`)} aria-current={current === hw.id ? 'page' : undefined}>{hw.title ? `${hw.id.toUpperCase()} · ${hw.title}` : hw.id.toUpperCase()}</a>)}</nav>
        </details>
        <nav class="site-links" aria-label="站点链接">
          <ExternalLink href="https://starlab.top/">博客</ExternalLink>
          <ExternalLink href="https://docs.starlab.top/">档案库</ExternalLink>
          <a href={href('about/')} aria-current={current === 'about' ? 'page' : undefined}>关于项目</a>
        </nav>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer"><span>可视化导论</span><span>观察 · 理解 · 表达</span></footer>
  </body>
</html>
